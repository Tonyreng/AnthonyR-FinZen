# Docker Compose project
COMPOSE_PROJECT_NAME=finzen
FRONTEND_PORT=3000
BACKEND_PORT=5001
POSTGRES_PORT=5432

# PostgreSQL (replace every placeholder outside disposable local development)
POSTGRES_USER=finzen
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=finzen

# Native backend execution only. Docker Compose builds DATABASE_URL from the
# three POSTGRES_* values above and the internal hostname `db`.
DATABASE_URL=postgresql://finzen:replace-with-a-local-password@localhost:5432/finzen

# Flask and JWT
FLASK_DEBUG=1
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_COOKIE_SECURE=false
JWT_COOKIE_CSRF_PROTECT=true
JWT_COOKIE_SAMESITE=Lax
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional administration and diagnostics
ENABLE_ADMIN=false
FLASK_APP_KEY=replace-only-when-admin-is-enabled
ADMIN_USERNAME=
ADMIN_PASSWORD=
ENABLE_DEBUG_ROUTES=false

# Vite uses the direct backend in development. Production uses same-origin
# requests through the Nginx /api proxy and builds with an empty value.
VITE_API_URL=http://localhost:5001
